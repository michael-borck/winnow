{
  "name": "@michaelborck/winnow-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop shell for Winnow",
  "license": "MIT",
  "author": "Michael Borck",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "package": "electron-builder --config electron-builder.config.js",
    "package:mac": "electron-builder --config electron-builder.config.js --mac",
    "package:win": "electron-builder --config electron-builder.config.js --win",
    "package:linux": "electron-builder --config electron-builder.config.js --linux"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  }
}
